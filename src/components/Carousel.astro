---
import type { MediaItem as Item } from '../schema/post';
import Icon from './Icon.astro';
import MediaItem from './MediaItem.astro';

interface Props {
  items: Item[];
  aspect: number;
}

const { items, aspect } = Astro.props;
---
<div class="carousel" data-carousel style={`--aspect: ${aspect}`}>
  <ul class="carousel-track" style={`aspect-ratio: ${aspect}`}>
    {items.map((item, i) => (
      <li aria-label={`${i + 1} of ${items.length}`}>
        <MediaItem item={item} aspect={aspect} eager={i === 0} />
      </li>
    ))}
  </ul>
  <button type="button" class="carousel-step prev" data-step="-1" aria-label="Previous photo"><Icon name="prev" size={18} /></button>
  <button type="button" class="carousel-step next" data-step="1" aria-label="Next photo"><Icon name="next" size={18} /></button>
  <div class="carousel-dots" aria-hidden="true">{items.map(() => <span></span>)}</div>
  <p class="carousel-count visually-hidden" aria-live="polite"><span data-index>1</span> / {items.length}</p>
</div>

<script>
  import { initCarousels } from '../client/carousel';
  initCarousels();
</script>
