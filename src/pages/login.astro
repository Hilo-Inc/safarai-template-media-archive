---
import '../styles/base.css';
import { readJson } from '../lib/json-cache';
import { mediaUrl } from '../lib/media-url';
import { readSite } from '../server/pages';

const next = Astro.url.searchParams.get('next') ?? '/';
const site = await readSite(readJson).catch(() => null);
const title = site?.title ?? 'Archive';
const avatarUrl = site?.avatar ? await mediaUrl(site.avatar).catch(() => null) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in · {title}</title>
  </head>
  <body>
    <form id="login" class="card form-ui" data-next={next}>
      {avatarUrl ? <img class="avatar" src={avatarUrl} alt="" width="64" height="64" /> : <span class="avatar" aria-hidden="true"></span>}
      <h1>{title}</h1>
      <p class="lead">Sign in to continue</p>
      <label>Password <input id="password" name="password" type="password" autocomplete="current-password" required autofocus /></label>
      <button type="submit" class="button">Sign in</button>
      <p role="alert" id="error" class="error"></p>
    </form>
    <script>
      const form = document.getElementById('login') as HTMLFormElement;
      const error = document.getElementById('error')!;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        error.textContent = '';
        const password = (form.elements.namedItem('password') as HTMLInputElement).value;
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ password, next: form.dataset.next }),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok) location.assign(body.next ?? '/');
        else error.textContent = body.error ?? 'Sign-in failed';
      });
    </script>
  </body>
</html>

<style>
  body { min-height: 100dvh; display: grid; place-items: center; padding: var(--sp-4); }
  .card { width: min(360px, 100%); display: grid; gap: var(--sp-3); justify-items: center; padding: var(--sp-5); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); }
  .avatar { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; background: var(--tile); }
  h1 { font-size: var(--fs-lg); }
  .lead { color: var(--muted); margin-bottom: var(--sp-2); }
  label, .button { width: 100%; }
  .error { min-height: 1.45em; font-size: var(--fs-sm); }
</style>
