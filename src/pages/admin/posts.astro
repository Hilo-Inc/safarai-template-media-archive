---
import AdminLayout from '../../components/AdminLayout.astro';
import { formatDate } from '../../render/format';
import { HIDDEN_NOTICE, loadAdminPosts } from '../../server/admin';
import { pageDeps } from '../../server/pages';

const index = await loadAdminPosts(pageDeps());
const thumb = (p: (typeof index.posts)[number]) =>
  p.cover ? ([...p.cover.variants].sort((a, b) => a.w - b.w).find((v) => v.w >= 320)?.src ?? p.cover.src) : null;
---
<AdminLayout title="Posts" current="/admin/posts">
  <p class="hint" id="hidden-notice">{HIDDEN_NOTICE}</p>
  <form class="filter" data-filter>
    <input type="search" name="text" placeholder="Search captions" aria-label="Search captions" />
    <select name="show" aria-label="Show">
      <option value="all">All</option>
      <option value="visible">Visible</option>
      <option value="hidden">Hidden</option>
      <option value="featured">Featured</option>
    </select>
    <span class="hint" data-count>{index.posts.length} posts</span>
  </form>
  {index.posts.length === 0 && <p class="hint">No posts yet. <a href="/admin">Import your files.</a></p>}
  <ul class="posts" data-posts>
    {index.posts.map((p) => (
      <li data-id={p.id} data-caption={p.caption}>
        <a href={`/p/${p.id}`} class="thumb">{thumb(p) ? <img src={thumb(p)} alt="" width="96" height="96" loading="lazy" /> : <span>{p.kind}</span>}</a>
        <div class="fields">
          <p class="meta">{formatDate(p.published)} · {p.kind} · {p.platform}{p.count > 1 && ` · ${p.count} items`}</p>
          <label><input type="checkbox" data-field="hidden" checked={p.hidden} aria-describedby="hidden-notice" /> Hidden</label>
          <label><input type="checkbox" data-field="featured" checked={p.featured} /> Featured</label>
          <button type="button" data-edit>Edit caption, alt text and place</button>
          <p class="error" data-error></p>
        </div>
      </li>
    ))}
  </ul>
</AdminLayout>

<script>
  import '../../client/admin-posts';
</script>

<style>
  .filter { display: flex; gap: var(--sp-2); align-items: center; flex-wrap: wrap; }
  .filter input[type='search'] { flex: 1 1 14rem; }
  .posts { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-3); }
  .posts > li { display: grid; grid-template-columns: 96px 1fr; gap: var(--sp-3); padding-bottom: var(--sp-3); border-bottom: 1px solid var(--line); }
  .thumb img, .thumb span { width: 96px; height: 96px; object-fit: cover; border-radius: var(--r-sm); background: var(--tile); display: grid; place-items: center; color: var(--muted); }
  .fields, .fields :global(.fields) { display: grid; gap: var(--sp-2); align-content: start; }
  .fields :global(textarea) { width: 100%; }
  .meta, .hint { color: var(--muted); font-size: var(--fs-xs); }
  .fields :global(.saving) { opacity: 0.6; }
  .fields :global(.save-status) { font-size: var(--fs-xs); color: var(--muted); min-height: 1.45em; transition: opacity 300ms; }
  .fields :global(.save-status.error) { color: var(--danger); }
  .fields :global(.save-status.faded) { opacity: 0; }
  @media (max-width: 735px) {
    .posts > li { grid-template-columns: 64px 1fr; padding: var(--sp-3); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); }
    .thumb img, .thumb span { width: 64px; height: 64px; }
  }
</style>
