{
  "name": "safarai-template-media-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build && esbuild src/start.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/start.mjs",
    "start": "node dist/start.mjs",
    "test": "vitest run",
    "test:int": "docker compose run --rm --build test",
    "test:int:inner": "vitest run --config vitest.int.config.ts",
    "typecheck": "astro check",
    "lint": "eslint .",
    "sample-export": "esbuild scripts/sample-export.ts --bundle --platform=node --format=esm --target=node22 --packages=external --log-level=warning --outfile=.cache/sample-export.mjs && node .cache/sample-export.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.7",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@uppy/aws-s3": "6.2.2",
    "@uppy/core": "6.2.0",
    "@zip.js/zip.js": "2.23.0",
    "astro": "7.3.8",
    "feed": "6.0.0",
    "file-type": "22.1.1",
    "media-chrome": "4.19.3",
    "sharp": "0.35.5",
    "thumbhash": "0.1.1",
    "wavesurfer.js": "8.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
