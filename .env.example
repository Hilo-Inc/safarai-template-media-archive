# Written by Safarai when the app is launched there. Set them yourself when self-hosting.

# S3-compatible storage (Cloudflare R2, Hetzner Object Storage, MinIO, ...).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=my-archive
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 for servers that need path-style URLs (MinIO, s3mock).
S3_FORCE_PATH_STYLE=

# public: anyone can view; password: viewers need VIEWER_PASSWORD.
SITE_VISIBILITY=public
# Public mode only: the address the bucket is served at, e.g. https://media.example.com. Empty means media URLs are presigned.
MEDIA_PUBLIC_URL=

# Sign-in for the admin (/admin). Use a long random value (at least 12 characters).
ADMIN_PASSWORD=
# Or set ADMIN_PASSWORD_HASH (see README); it wins over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
# Password mode only: the password for viewers (at least 12 characters, different from ADMIN_PASSWORD).
VIEWER_PASSWORD=
# Or set VIEWER_PASSWORD_HASH (see README); it wins over VIEWER_PASSWORD.
VIEWER_PASSWORD_HASH=

# The site's own address, used in feed links (never taken from the request). Optional when COOLIFY_URL is set.
SITE_URL=
# Set by Coolify; the first address is used for feed links when SITE_URL is empty.
# COOLIFY_URL=

# Scratch directory for processing uploads (needs room for twice the largest file). Default: the system temp directory.
# WORK_DIR=

# Optional overrides of archive.config.json. ARCHIVE_CONFIG is the path of a different config file (default: archive.config.json).
# ARCHIVE_CONFIG=
ARCHIVE_PRESET=
ARCHIVE_KINDS=
ARCHIVE_LOCATION=
ARCHIVE_MENTIONS=
# Optional: a fixed secret for session cookies. By default it is derived from the passwords, so changing one signs everyone out.
SESSION_SECRET=
