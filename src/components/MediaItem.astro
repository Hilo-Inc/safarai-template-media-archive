---
import { aspectOf, IMAGE_SIZES, srcset } from '../render/choose-layout';
import { formatDuration } from '../render/format';
import type { MediaItem } from '../schema/post';

interface Props {
  item: MediaItem;
  /** Box aspect ratio (width / height); defaults to the item's own. */
  aspect?: number;
  eager?: boolean;
}

const { item, aspect, eager = false } = Astro.props;
const ratio = aspect ?? aspectOf(item);
const box = `aspect-ratio: ${ratio}`;
const pick = (variants: { w: number; src: string }[], fallback: string) =>
  [...variants].sort((a, b) => b.w - a.w).find((v) => v.w <= 1280)?.src ?? fallback;
---
{item.type === 'image' && (
  <img
    class="media"
    src={pick(item.variants, item.src)}
    srcset={item.variants.length > 0 ? srcset(item.variants) : undefined}
    sizes={IMAGE_SIZES}
    width={item.width}
    height={item.height}
    alt={item.alt ?? ''}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    style={box}
  />
)}
{item.type === 'video' && item.playable && (
  <media-controller class="media" style={box}>
    <video
      slot="media"
      src={item.src}
      poster={item.poster ? pick(item.poster.variants, item.poster.src) : undefined}
      preload="metadata"
      playsinline
      crossorigin={item.subtitles.length > 0 ? 'anonymous' : undefined}
    >
      {item.subtitles.map((s, i) => (
        <track kind="subtitles" src={s.src} srclang={s.lang ?? 'und'} label={s.lang ?? 'Subtitles'} default={i === 0} />
      ))}
    </video>
    <media-control-bar>
      <media-play-button></media-play-button>
      <media-mute-button></media-mute-button>
      <media-time-range></media-time-range>
      <media-time-display showduration></media-time-display>
      {item.subtitles.length > 0 && <media-captions-button></media-captions-button>}
      <media-fullscreen-button></media-fullscreen-button>
    </media-control-bar>
  </media-controller>
)}
{item.type === 'video' && !item.playable && (
  <figure class="media unplayable" style={box}>
    {item.poster ? <img src={pick(item.poster.variants, item.poster.src)} alt="" width={item.poster.width} height={item.poster.height} loading="lazy" /> : <div class="blank"></div>}
    <figcaption>
      This video's format can't play in a web browser.
      <a href={item.src} download>Download the video</a> ({formatDuration(item.duration)})
    </figcaption>
  </figure>
)}
{item.type === 'audio' && (
  <div class="media audio" data-audio data-peaks={item.peaks ?? ''} data-duration={item.duration}>
    <div class="wave" data-wave></div>
    <audio controls preload="metadata" src={item.src}></audio>
  </div>
)}

<script>
  import 'media-chrome';
  import '../client/audio';
</script>

<style>
  .media { width: 100%; background: var(--tile); object-fit: contain; display: block; }
  media-controller { display: block; }
  media-controller video { width: 100%; height: 100%; object-fit: contain; }
  .unplayable { position: relative; margin: 0; }
  .unplayable img, .unplayable .blank { width: 100%; height: 100%; object-fit: contain; opacity: 0.6; }
  .unplayable figcaption { position: absolute; inset: auto 0 0; padding: 0.75rem; background: #000c; color: #fff; }
  .unplayable a { color: #fff; font-weight: 600; }
  .audio { padding: 1rem; display: grid; gap: 0.5rem; background: none; }
  .audio audio { width: 100%; }
  .wave:empty { display: none; }
</style>
