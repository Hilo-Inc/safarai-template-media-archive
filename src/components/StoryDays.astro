---
import { thumbHashToAverageRGBA } from 'thumbhash';
import { srcset } from '../render/choose-layout';
import { formatDate } from '../render/format';
import { storyDays } from '../render/stories';
import type { StoryMonth } from '../schema/index-types';

interface Props {
  month: StoryMonth;
}

const days = storyDays(Astro.props.month).map((d) => {
  const first = d.stories[0]!;
  const cover = first.cover;
  const small = cover ? ([...cover.variants].sort((a, b) => a.w - b.w).find((v) => v.w >= 640) ?? cover.variants.at(-1)) : undefined;
  let placeholder = '';
  if (cover?.thumbhash) {
    const { r, g, b } = thumbHashToAverageRGBA(Uint8Array.from(Buffer.from(cover.thumbhash, 'base64')));
    placeholder = `background-color: rgb(${Math.round(r * 255)} ${Math.round(g * 255)} ${Math.round(b * 255)})`;
  }
  return { ...d, first, cover, small, placeholder };
});
---
<ul class="days">
  {days.map((d) => (
    <li>
      <a class="day" href={`/p/${d.first.id}`} data-story-id={d.first.id} aria-label={`${formatDate(d.published)}, ${d.stories.length} ${d.stories.length === 1 ? "story" : "stories"}`}>
        {d.cover && (
          <img
            src={d.small?.src ?? d.cover.src}
            srcset={d.cover.variants.length > 0 ? srcset(d.cover.variants) : undefined}
            sizes="(max-width: 735px) 34vw, 160px"
            alt=""
            width={d.cover.width}
            height={d.cover.height}
            loading="lazy"
            decoding="async"
            style={d.placeholder}
          />
        )}
        <span class="date">{formatDate(d.published)}</span>
        <span class="n">{d.stories.length}</span>
      </a>
      {d.stories.length > 1 && (
        <ol class="more" aria-label="More stories this day">
          {d.stories.slice(1).map((s, i) => <li><a href={`/p/${s.id}`} data-story-id={s.id}>{i + 2}</a></li>)}
        </ol>
      )}
    </li>
  ))}
</ul>

<style>
  .days { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--sp-3); }
  .day { position: relative; display: block; aspect-ratio: 9 / 16; overflow: hidden; border-radius: var(--r-md); background: var(--tile); text-decoration: none; color: #fff; }
  .day img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .date { position: absolute; left: var(--sp-2); bottom: var(--sp-2); font-size: var(--fs-xs); font-weight: 600; text-shadow: 0 0 4px rgb(0 0 0 / 0.7); }
  .n { position: absolute; top: var(--sp-2); right: var(--sp-2); padding: 0 var(--sp-1); border-radius: 4px; background: rgb(0 0 0 / 0.7); font-size: var(--fs-xs); font-variant-numeric: tabular-nums; }
  .more { list-style: none; margin: var(--sp-1) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--sp-1); }
  .more a { display: inline-block; min-width: 1.5rem; text-align: center; padding: 0 var(--sp-1); border-radius: var(--r-sm); background: var(--tile); font-size: var(--fs-xs); text-decoration: none; }
</style>
