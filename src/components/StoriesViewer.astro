---
import Icon from './Icon.astro';
---
<dialog class="story-viewer" data-story-viewer aria-label="Stories">
  <div class="frame" data-frame tabindex="-1">
    <div class="bars" data-bars aria-hidden="true"></div>
    <div class="stage" data-stage></div>
    <p class="caption" data-caption></p>
    <p class="error" data-error role="alert" hidden>This story couldn't load</p>
    <div class="controls">
      <button type="button" data-pause aria-pressed="false">Pause</button>
      <button type="button" data-mute aria-pressed="false">Mute</button>
      <button type="button" data-close aria-label="Close"><Icon name="close" /></button>
    </div>
  </div>
</dialog>

<script>
  import '../client/stories';
</script>

<style>
  .story-viewer { inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: #000; color: #fff; }
  .story-viewer::backdrop { background: #000; }
  .frame { position: relative; height: 100%; aspect-ratio: 9 / 16; max-width: 100%; margin: 0 auto; touch-action: none; user-select: none; outline: none; }
  .stage, .stage :global(img), .stage :global(video) { width: 100%; height: 100%; object-fit: contain; display: block; }
  .bars { position: absolute; inset: 0.5rem 0.5rem auto; display: flex; gap: 0.25rem; z-index: 2; }
  .bars :global(span) { flex: 1; height: 3px; background: rgb(255 255 255 / 0.35); border-radius: 2px; overflow: hidden; }
  .bars :global(i) { display: block; height: 100%; width: 0; background: #fff; }
  .caption { position: absolute; inset: auto 0 3.5rem; margin: 0; padding: 0.75rem 1rem; white-space: pre-line; background: linear-gradient(transparent, rgb(0 0 0 / 0.6)); }
  .caption:empty { display: none; }
  .error { position: absolute; inset: 45% 0 auto; text-align: center; }
  .controls { position: absolute; inset: auto 0.5rem 0.5rem; display: flex; gap: 0.5rem; justify-content: flex-end; z-index: 2; }
  .controls button { background: rgb(0 0 0 / 0.5); color: #fff; border: 1px solid rgb(255 255 255 / 0.4); border-radius: 999px; padding: 0.4rem 0.8rem; }
  .stage { transition: opacity 150ms; }
  @media (prefers-reduced-motion: reduce) {
    .stage { transition: none; }
  }
</style>
