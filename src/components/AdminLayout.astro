---
import Layout from './Layout.astro';
import { loadConfig } from '../config/load';

interface Props {
  title: string;
  current: '/admin' | '/admin/posts' | '/admin/site' | '/admin/export-guide';
}

const { title, current } = Astro.props;
const links = [
  ['/admin', 'Import'],
  ['/admin/posts', 'Posts'],
  ['/admin/site', 'Site'],
  ['/admin/export-guide', 'Export guide'],
] as const;
---
<Layout title={`${title} · Admin`} visibility={loadConfig().visibility} admin>
  <main class="admin form-ui">
    <nav class="tabbar admin-nav" aria-label="Admin">
      {links.map(([href, label]) => <a href={href} aria-current={href === current ? 'page' : undefined}>{label}</a>)}
      <a class="view" href="/">View site</a>
    </nav>
    <div class="admin-body">
      <h1>{title}</h1>
      <slot />
    </div>
  </main>
</Layout>

<style>
  .admin-nav { position: sticky; top: 0; z-index: 10; }
  .admin-nav .view { margin-left: auto; color: var(--accent); }
  .admin-body { display: grid; gap: var(--sp-4); padding: var(--sp-5) var(--sp-4); }
  h1 { font-size: var(--fs-lg); }
  .admin-body :global(h2) { font-size: var(--fs-md); margin: var(--sp-4) 0 0; }
</style>
