---
import Icon from './Icon.astro';
---
<dialog class="viewer" data-viewer aria-label="Post">
  <div class="viewer-frame" data-viewer-body tabindex="-1"></div>
  <button type="button" class="viewer-close" data-viewer-close aria-label="Close"><Icon name="close" /></button>
  <div class="viewer-bar">
    <button type="button" class="viewer-step prev" data-viewer-step="-1" aria-label="Previous post"><Icon name="prev" /></button>
    <button type="button" class="viewer-step next" data-viewer-step="1" aria-label="Next post"><Icon name="next" /></button>
  </div>
</dialog>

<script>
  import '../client/viewer';
</script>

<style>
  .viewer { width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: var(--fg); overflow: hidden; }
  .viewer[open] { display: grid; place-items: center; animation: viewer-in 150ms ease-out; }
  .viewer::backdrop { background: rgb(0 0 0 / 0.7); }
  .viewer[aria-busy='true'] .viewer-frame { opacity: 0.6; transition: opacity 150ms 100ms; }
  @keyframes viewer-in { from { opacity: 0; } }

  .viewer-frame { --frame-h: 92vh; width: min(1200px, 100vw - 160px); height: 92vh; overflow: hidden; background: var(--surface); border-radius: var(--r-md); touch-action: pan-y; }
  .viewer-frame:focus { outline: none; }
  .viewer-frame :global(.post) { height: 100%; grid-template-columns: minmax(0, 1fr) 22rem; gap: 0; align-items: stretch; }
  .viewer-frame :global(.post-media) { display: grid; place-items: center; min-height: 0; background: #000; }
  .viewer-frame :global(.post-text) { overflow-y: auto; padding: var(--sp-4); border-left: 1px solid var(--line); }
  .viewer-frame :global(.post:is(.audio, .story) .post-media) { background: var(--surface); }

  .viewer-close, .viewer-step { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: var(--r-full); background: rgb(255 255 255 / 0.12); color: #fff; cursor: pointer; }
  .viewer-close:hover, .viewer-step:hover { background: rgb(255 255 255 / 0.24); }
  .viewer-step:disabled { visibility: hidden; }
  .viewer-close { position: fixed; top: var(--sp-3); right: var(--sp-3); }
  .viewer-bar { display: contents; }
  .viewer-step { position: fixed; top: 50%; translate: 0 -50%; }
  .viewer-step.prev { left: var(--sp-4); }
  .viewer-step.next { right: var(--sp-4); }

  @media (max-width: 899px) {
    .viewer[open] { display: block; }
    .viewer-frame { --frame-h: 75vh; width: 100%; height: 100%; border-radius: 0; overflow-y: auto; padding-bottom: calc(56px + env(safe-area-inset-bottom)); }
    .viewer-frame :global(.post) { height: auto; grid-template-columns: 1fr; gap: var(--sp-3); }
    .viewer-frame :global(.post-text) { overflow: visible; border-left: 0; padding: 0 var(--sp-4) var(--sp-4); }
    .viewer-close { top: var(--sp-2); right: var(--sp-2); z-index: 2; background: rgb(0 0 0 / 0.5); }
    .viewer-bar { display: flex; justify-content: space-between; align-items: center; position: fixed; inset: auto 0 0; height: calc(56px + env(safe-area-inset-bottom)); padding: 0 var(--sp-4) env(safe-area-inset-bottom); background: var(--surface); border-top: 1px solid var(--line); }
    .viewer-step { position: static; translate: none; color: var(--fg); background: transparent; }
  }

  :global(html:has(.viewer[open])) { overflow: hidden; }
</style>
