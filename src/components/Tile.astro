---
import { thumbHashToAverageRGBA } from 'thumbhash';
import { KIND_LABELS, type Look } from '../render/preset-look';
import { firstLine } from '../render/caption';
import { srcset } from '../render/choose-layout';
import { formatDate, formatDuration } from '../render/format';
import { tileHover, tileIcon } from '../render/tile';
import type { PostSummary } from '../schema/index-types';
import Icon from './Icon.astro';

interface Props {
  post: PostSummary;
  look: Look;
}

const { post, look } = Astro.props;
const cover = post.cover;
const small = cover ? ([...cover.variants].sort((a, b) => a.w - b.w).find((v) => v.w >= 640) ?? cover.variants.at(-1)) : undefined;
let placeholder = '';
if (cover?.thumbhash) {
  const { r, g, b } = thumbHashToAverageRGBA(Uint8Array.from(Buffer.from(cover.thumbhash, 'base64')));
  placeholder = `background-color: rgb(${Math.round(r * 255)} ${Math.round(g * 255)} ${Math.round(b * 255)})`;
}
const label = firstLine(post.caption, 120) || KIND_LABELS[post.kind] || 'Post';
const showDuration = look.durationBadge && post.duration !== null;
const icon = tileIcon(post);
const iconText = icon === 'pin' ? 'Pinned' : icon === 'carousel' ? `${post.count} items` : null;
---
{look.tile === 'row' ? (
  <a class="row" href={`/p/${post.id}`}>
    {cover && <img src={small?.src ?? cover.src} alt="" width="64" height="64" loading="lazy" decoding="async" style={placeholder} />}
    <span class="text">{label}</span>
    <span class="meta">{formatDate(post.published)}{post.duration !== null && ` · ${formatDuration(post.duration)}`}</span>
  </a>
) : (
  <a class="tile" href={`/p/${post.id}`} style={`aspect-ratio: ${look.tileAspect}`} aria-label={label}>
    {cover ? (
      <img
        src={small?.src ?? cover.src}
        srcset={cover.variants.length > 0 ? srcset(cover.variants) : undefined}
        sizes="(max-width: 975px) 34vw, 320px"
        alt=""
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
        style={placeholder}
      />
    ) : (
      <span class="text"><Icon name={post.kind === 'track' ? 'audio' : 'carousel'} size={20} /><span class="line">{label}</span></span>
    )}
    {icon && <span class="corner"><Icon name={icon} size={20} />{iconText && <span class="visually-hidden">{iconText}</span>}</span>}
    {showDuration && <span class="duration">{formatDuration(post.duration!)}</span>}
    <span class="hover" aria-hidden="true">{tileHover(post)}</span>
  </a>
)}

<style>
  .tile { position: relative; display: block; overflow: hidden; background: var(--tile); }
  .tile img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .tile .text { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: var(--sp-2); padding: var(--sp-3); text-align: center; font-size: var(--fs-sm); color: var(--muted); }
  .tile .line { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; color: var(--fg); }
  .corner { position: absolute; top: var(--sp-2); right: var(--sp-2); color: #fff; filter: drop-shadow(0 0 2px rgb(0 0 0 / 0.6)); }
  .duration { position: absolute; bottom: var(--sp-2); right: var(--sp-2); padding: 0 var(--sp-1); border-radius: 4px; background: rgb(0 0 0 / 0.7); color: #fff; font-size: var(--fs-xs); font-variant-numeric: tabular-nums; }
  .hover { position: absolute; inset: 0; display: grid; place-items: center; padding: var(--sp-2); background: var(--scrim); color: #fff; font-size: var(--fs-sm); font-weight: 600; text-align: center; opacity: 0; transition: opacity 120ms; }
  .tile:focus-visible { outline-offset: -2px; }
  .tile:focus-visible .hover { opacity: 1; }
  @media (hover: hover) and (pointer: fine) { .tile:hover .hover { opacity: 1; } }
  .row { display: grid; grid-template-columns: 64px 1fr; gap: 0 var(--sp-3); padding: var(--sp-2) var(--sp-4); text-decoration: none; border-bottom: 1px solid var(--line); }
  .row img { grid-row: span 2; width: 64px; height: 64px; object-fit: cover; background: var(--tile); border-radius: var(--r-sm); }
  .row .meta { color: var(--muted); font-size: var(--fs-xs); }
</style>
